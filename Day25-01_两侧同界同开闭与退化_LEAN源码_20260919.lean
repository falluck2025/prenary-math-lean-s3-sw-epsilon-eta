import Mathlib

/-!
Day25-01 · S3-SW · 两侧同界且同开闭与退化

本文件把"数学侧残差 ε 与物理侧超额 η 共用同一个**开**区间 (0, δ₀)"写成可验证命题。
全部落在 ℝ 上（不引入 ℂ）：ε、η 为实数，δ₀ 为实数界。

背景（来路，仅备忘，不作依据）：
- 数学侧 ε ∈ (0, δ₀)：004 定稿（2026-09-12）确立，δ₀ 不可达。
- 物理侧 η ∈ (0, δ₀)：与数学侧同开（2026-09-19 口径对齐；原旧线写法为 (0, δ₀]）。

本文件只写"结构"：两侧同界、同开、同退化。不含数值锁定。
-/

namespace PrenaryBridge

/-- 桥结构：两侧（数学侧残差 ε、物理侧超额 η）共用同一个开区间 (0, δ₀)。
    要求 δ₀ > 0，且两侧残差都严格落在 (0, δ₀) 内（即 δ₀ 两侧都不可达）。 -/
def IsBridge (δ₀ ε η : ℝ) : Prop :=
  0 < δ₀ ∧ (0 < ε ∧ ε < δ₀) ∧ (0 < η ∧ η < δ₀)

/-- 定理 1（同界且同开闭）：两侧残差落在同一个开区间 (0, δ₀)。 -/
theorem same_open_interval {δ₀ ε η : ℝ} (h : IsBridge δ₀ ε η) :
    (0 < ε ∧ ε < δ₀) ∧ (0 < η ∧ η < δ₀) :=
  ⟨h.2.1, h.2.2⟩

/-- 定理 2（两侧都严格小于界 ⟹ δ₀ 不可达）。 -/
theorem both_below_bound {δ₀ ε η : ℝ} (h : IsBridge δ₀ ε η) :
    ε < δ₀ ∧ η < δ₀ :=
  ⟨h.2.1.2, h.2.2.2⟩

/-- 定理 3（两侧残差都为正）。 -/
theorem both_positive {δ₀ ε η : ℝ} (h : IsBridge δ₀ ε η) :
    0 < ε ∧ 0 < η :=
  ⟨h.2.1.1, h.2.2.1⟩

/-- 定理 4（退化）：δ₀ = 0 时桥为空 —— 即不存在这样的桥结构，
    两侧同时退回"无残差"（经典）。 -/
theorem no_bridge_at_zero (ε η : ℝ) : ¬ IsBridge 0 ε η := by
  intro h
  exact absurd h.1 (lt_irrefl (0 : ℝ))

end PrenaryBridge
